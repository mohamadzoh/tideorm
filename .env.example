# TideORM Test Database Configuration
# Copy this file to .env and adjust the values as needed

# =============================================================================
# POSTGRESQL (Default)
# =============================================================================
# PostgreSQL connection string for tests, examples, and benchmarks.
# The test helper reads TEST_DATABASE_URL FIRST and only falls back to
# POSTGRESQL_DATABASE_URL; benchmarks read POSTGRESQL_DATABASE_URL only.
# Fallback when neither is set: postgres://postgres:postgres@localhost:5432/test_tide_orm
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/test_tide_orm
POSTGRESQL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/test_tide_orm

# =============================================================================
# MYSQL / MariaDB
# =============================================================================
# MySQL is OPT-IN: the suites run when RUN_MYSQL_TESTS *or* MYSQL_DATABASE_URL
# is set. Setting the line below therefore ENABLES MySQL tests, and there is no
# skip flag that turns them back off - comment it out (and leave
# RUN_MYSQL_TESTS unset) if you do not have a MySQL server.
# Fallback URL when only RUN_MYSQL_TESTS is set: mysql://root:@localhost:3306/test_tide_orm
# MYSQL_DATABASE_URL=mysql://root:root@localhost:3306/tideorm_test
# RUN_MYSQL_TESTS=1

# =============================================================================
# SQLITE
# =============================================================================
# SQLite connection string for integration tests
# In-memory: sqlite::memory:
# File-based: sqlite:./test_database.db
# Fallback when unset: sqlite://./test_tide_orm.db?mode=rwc
SQLITE_DATABASE_URL=sqlite::memory:

# =============================================================================
# TEST CONTROL
# =============================================================================
# Only the two flags below are read by any code.
#
# SKIP_SQLITE_TESTS   - opts out of the SQLite integration and entity-manager
#                       suites (set to any value).
# SKIP_POSTGRES_TESTS - gates ONLY postgres_entity_manager_tests. The main
#                       postgres_integration_tests / postgres_advanced_tests
#                       suites ignore it and always try to connect.
#
# There is no SKIP_MYSQL_TESTS; see the MySQL section above.
# SKIP_SQLITE_TESTS=1
# SKIP_POSTGRES_TESTS=1

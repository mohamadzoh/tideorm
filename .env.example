# TideORM Test Database Configuration
# Copy this file to .env and adjust the values as needed

# =============================================================================
# POSTGRESQL (Default)
# =============================================================================
# PostgreSQL connection string for tests, examples, and benchmarks.
# PostgreSQL is OPT-IN, like MySQL: the suites and benchmarks run when
# TEST_DATABASE_URL, POSTGRESQL_DATABASE_URL or RUN_POSTGRES_TESTS is set, so the
# uncommented line below ENABLES them; SKIP_POSTGRES_TESTS turns them back off.
# Tests and benchmarks read TEST_DATABASE_URL FIRST and only fall back to
# POSTGRESQL_DATABASE_URL.
# Fallback URL when only RUN_POSTGRES_TESTS is set: postgres://postgres:postgres@localhost:5432/test_tide_orm
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/test_tide_orm
POSTGRESQL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/test_tide_orm
# RUN_POSTGRES_TESTS=1

# =============================================================================
# MYSQL / MariaDB
# =============================================================================
# MySQL is OPT-IN: the suites run when RUN_MYSQL_TESTS *or* MYSQL_DATABASE_URL
# is set. Setting the line below therefore ENABLES MySQL tests; SKIP_MYSQL_TESTS
# (see TEST CONTROL) turns them back off without removing it.
# Fallback URL when only RUN_MYSQL_TESTS is set: mysql://root:@localhost:3306/test_tide_orm
# MYSQL_DATABASE_URL=mysql://root:root@localhost:3306/tideorm_test
# RUN_MYSQL_TESTS=1
#
# The MariaDB suites are opt-in the same way, through their own variables, so
# a MySQL and a MariaDB server can both be configured.
# Fallback URL when only RUN_MARIADB_TESTS is set: mysql://root:@localhost:3306/test_tide_orm
# MARIADB_DATABASE_URL=mysql://root:root@localhost:3307/tideorm_test
# RUN_MARIADB_TESTS=1

# =============================================================================
# SQLITE
# =============================================================================
# SQLite connection string for integration tests
# In-memory: sqlite::memory:
# File-based: sqlite:./test_database.db
# Fallback when unset: sqlite://./test_tide_orm.db?mode=rwc
SQLITE_DATABASE_URL=sqlite::memory:

# =============================================================================
# TEST CONTROL
# =============================================================================
# Only the four flags below are read by any code.
#
# SKIP_SQLITE_TESTS   - opts out of the SQLite integration and entity-manager
#                       suites (set to any value).
# SKIP_MYSQL_TESTS    - opts out of the MySQL suites even when MYSQL_DATABASE_URL
#                       or RUN_MYSQL_TESTS is set.
# SKIP_MARIADB_TESTS  - opts out of the MariaDB suites even when
#                       MARIADB_DATABASE_URL or RUN_MARIADB_TESTS is set.
# SKIP_POSTGRES_TESTS - opts out of the PostgreSQL suites and benchmarks even
#                       when a PostgreSQL URL or RUN_POSTGRES_TESTS is set.
#
# SKIP_SQLITE_TESTS=1
# SKIP_MYSQL_TESTS=1
# SKIP_MARIADB_TESTS=1
# SKIP_POSTGRES_TESTS=1
